.agents
.codex

# Python artefacts
**/__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache
.coverage
htmlcov

# Local state, logs, scratch files
*.log
tmp/
staticfiles/

