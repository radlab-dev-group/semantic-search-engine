!configs/embedders.json
!configs/generative-models.json
!configs/models.json
!configs/query-templates.json
!configs/rerankers.json
configs/not_tested
configs/secret-key.txt
!configs/secret-key.example.txt

# TLS material (mounted into the nginx container at run time)
nginx/certs

