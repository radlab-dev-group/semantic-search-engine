new file mode 100644
index 0000000..606921c
--- /dev/null
+++ b/src/sse_api/data/core/knowledge_extensions.py
@@ -0,0 +1,53 @@
+"""Pure helpers for the version-one agentic knowledge contract."""
+
+
+def lexical_query(question, keywords):
+    return " ".join(keywords) if keywords else question
+
+
+def intersect_filter_groups(groups, resolve):
+    sets = [set(resolve(group)) for group in groups]
+    return list(set.intersection(*sets)) if sets else []
+
+
+def merge_quality(metadata, upvotes, downvotes):
+    if any(type(v) is not int or v < 0 or v > 10**12 for v in (upvotes, downvotes)):
+        raise ValueError("Invalid quality counter")
+    result = dict(metadata or {})
+    old_up = result.get("upvotes", 0)
+    old_down = result.get("downvotes", 0)
+    up = max(upvotes, old_up if type(old_up) is int and old_up >= 0 else 0)
+    down = max(downvotes, old_down if type(old_down) is int and old_down >= 0 else 0)
+    result.update(
+        upvotes=up,
+        downvotes=down,
+        times_used=up + down,
+        success_rate=(up + 1) / (up + down + 2),
+        confidence_score=(up + 1) / (up + down + 2),
+    )
+    return result
+
+
+def keyword_match_mode(value="and"):
+    """Accept exactly the public API's two modes; omission means AND."""
+    if not isinstance(value, str) or value not in ("and", "any"):
+        raise ValueError("keywords_match must be 'and' or 'any'")
+    return value
+
+
+def build_fts_query(query_str, keywords, keywords_match, config, query_factory):
+    """OR/AND between keyword entries, with plain FTS parsing inside each.
+
+    Never interpolate untrusted keywords into a raw tsquery. Without keywords
+    the historical query_str/plain behavior stays unchanged, even in any mode.
+    """
+    mode = keyword_match_mode(keywords_match)
+    if not keywords:
+        return query_factory(query_str, config=config, search_type="plain")
+    query = None
+    for keyword in keywords:
+        part = query_factory(keyword, config=config, search_type="plain")
+        query = (
+            part if query is None else (query | part if mode == "any" else query & part)
+        )
+    return query
diff --git a/src/sse_api/data/tests/test_keywords_match.py b/src/sse_api/data/tests/test_keywords_match.py
new file mode 100644
index 0000000..b14dd7e
--- /dev/null
+++ b/src/sse_api/data/tests/test_keywords_match.py
@@ -0,0 +1,65 @@
+"""Boolean keyword composition and API enum validation, without a DB query."""
+
+from unittest import TestCase
+
+from sse_api.core.validation import search_options
+from sse_api.data.core.knowledge_extensions import build_fts_query
+
+
+class Query:
+    def __init__(self, value, **kwargs):
+        self.value = value
+        self.kwargs = kwargs
+
+    def __or__(self, other):
+        return Query(("OR", self.value, other.value))
+
+    def __and__(self, other):
+        return Query(("AND", self.value, other.value))
+
+
+class KeywordsMatchTests(TestCase):
+    def test_default_mode_is_and(self):
+        options = search_options({"keywords": ["TypeError", "pool"]})
+        self.assertNotIn("keywords_match", options)
+        query = build_fts_query(
+            "ignored",
+            options["keywords"],
+            options.get("keywords_match", "and"),
+            "simple",
+            Query,
+        )
+        self.assertEqual(query.value, ("AND", "TypeError", "pool"))
+
+    def test_explicit_modes_compose_between_entries(self):
+        for mode, expected in (("and", "AND"), ("any", "OR")):
+            with self.subTest(mode=mode):
+                self.assertEqual(
+                    build_fts_query(
+                        "unused", ["pool timeout", "TypeError"], mode, "simple", Query
+                    ).value,
+                    (expected, "pool timeout", "TypeError"),
+                )
+
+    def test_no_keywords_preserves_plain_query(self):
+        for words in (None, []):
+            for mode in ("and", "any"):
+                query = build_fts_query("original query", words, mode, "simple", Query)
+                self.assertEqual(query.value, "original query")
+                self.assertEqual(query.kwargs["search_type"], "plain")
+
+    def test_invalid_enum_is_rejected(self):
+        for value in ("all", "or", "AND", "", None, True, [], {}):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                search_options({"keywords_match": value})
+
+    def test_real_django_query_uses_safe_plain_parameters(self):
+        from django.contrib.postgres.search import SearchQuery
+
+        for mode, operator in (("and", "AND"), ("any", "OR")):
+            query = build_fts_query(
+                "unused", ["foo | !bar", "pool timeout"], mode, "simple", SearchQuery
+            )
+            self.assertEqual(query.connector, "&&" if mode == "and" else "||")
+            self.assertEqual(query.lhs.function, "plainto_tsquery")
+            self.assertEqual(query.rhs.function, "plainto_tsquery")
