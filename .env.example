# =============================================================================
# Semantic Search Engine - environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# Never commit `.env`. Values set here override `sse_rest_api/configs/*`.
# Generate secrets with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================================

# --- Django core -------------------------------------------------------------
ENV_SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET_KEY
# WARNING: keep 0 in production. 1 enables the debug page with full tracebacks.
ENV_DEBUG=0
ENV_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST over HTTPS (django.contrib.admin, DRF login form).
# Comma separated, scheme included, e.g. https://search.example.com.
# Leave empty for same-origin only - nginx forwards the original Host header.
ENV_CSRF_TRUSTED_ORIGINS=
ENV_DEFAULT_LANGUAGE=pl
ENV_SHOW_ADMIN_WINDOW=0
ENV_PUBLIC_API_AVAILABLE=1
# Logger profile: dev | demo | prod
ENV_LOGGER=prod

# --- PostgreSQL --------------------------------------------------------------
ENV_DB_ENGINE=django.db.backends.postgresql
ENV_DB_NAME=sse_backend
ENV_DB_USERNAME=admin
ENV_DB_PASSWORD=CHANGE_ME
ENV_DB_HOST=localhost
ENV_DB_PORT=5471

# Used by scripts/admin/postgres.sh and docker-compose.yml
POSTGRES_DB=sse_backend
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5471
# Used by scripts/admin/postgres.sh: keep 127.0.0.1 and firewall/SSH-tunnel
# remote access. Only a containerised stack may need 0.0.0.0.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_DATA_DIR=/var/lib/postgresql_data_sse

# --- Milvus ------------------------------------------------------------------
# Connection scheme (`uri`: http | https) is read from
# sse_rest_api/configs/milvus_config.json and is not overridable here.
ENV_MILVUS_HOST=localhost
ENV_MILVUS_PORT=19530
ENV_MILVUS_DBNAME=sse_backend_engine
ENV_MILVUS_USER=sse_user
ENV_MILVUS_PASSWORD=CHANGE_ME

# --- Authentication ----------------------------------------------------------
ENV_USE_KC_AUTH=0
ENV_USE_OAUTH_V1_AUTH=0
ENV_USE_OAUTH_V2_AUTH=0
ENV_USE_INTROSPECT=0
ENV_INTROSPECT_EMAIL_VERIFICATION=0

# --- Optional integrations ---------------------------------------------------
ENV_USE_CELERY=0
ENV_CELERY_BROKER_URL=amqp://CHANGE_ME:CHANGE_ME@localhost:5672/
ENV_USE_AWS=0

# --- External model / API keys ----------------------------------------------
LLM_ROUTER_API=
OPENAI_API_KEY=
DEEPL_AUTH_KEY=

# --- Uploads -----------------------------------------------------------------
# Must be >= the largest document you accept (bytes). Nginx client_max_body_size
# has to match this value.
DATA_UPLOAD_MAX_MEMORY_SIZE=2684354560
FILE_UPLOAD_MAX_MEMORY_SIZE=2684354560

# --- gunicorn ----------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
# Recycle a worker after roughly this many requests (0 disables it). Guards
# against slow memory growth of the embedding models.
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
# Fork-safety of the CUDA context: leave 0 unless every worker is CPU only.
GUNICORN_PRELOAD=0
GUNICORN_LOGLEVEL=info
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-

# --- Docker Compose stack ----------------------------------------------------
# Image tag built/used by docker-compose.yml (kept in sync with `.version`).
SSE_IMAGE_TAG=0.0.2
# Host port of the API container. It is published on 127.0.0.1 only — nginx is
# the single public entry point.
API_HOST_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Address the Milvus ports are published on (19530 SDK, 19121 metrics). Used by
# docker-compose.yml and run.sh/run-en.sh. Keep the loopback default; 0.0.0.0
# only on a trusted network.
MILVUS_BIND_HOST=127.0.0.1
MILVUS_HOST_PORT=19530
MILVUS_METRICS_HOST_PORT=19121
# Enable Milvus RBAC only after `ENV_MILVUS_USER`/`ENV_MILVUS_PASSWORD` exist
# inside Milvus; the stock image starts with authorization off.
MILVUS_AUTH_ENABLED=false
# Credentials of the MinIO instance backing Milvus (compose network only, no
# published ports). docker-compose.yml refuses to start when these are missing.
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# --- image build args --------------------------------------------------------
# Optional, not-on-PyPI dependencies baked into the image (same installs as
# `./initialize.sh dep`).
INSTALL_RADLAB_DATA=0
INSTALL_LLM_ROUTER=0
RADLAB_DATA_REF=master
LLM_ROUTER_REF=master
