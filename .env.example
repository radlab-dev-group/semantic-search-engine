# =============================================================================
# Semantic Search Engine - environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# Never commit `.env`. Values set here override `configs/*`.
# Generate secrets with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================================

# --- Django core -------------------------------------------------------------
ENV_SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET_KEY
# WARNING: keep 0 in production. 1 enables the debug page with full tracebacks.
ENV_DEBUG=0
ENV_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST over HTTPS (django.contrib.admin, DRF login form).
# Comma separated, scheme included, e.g. https://search.example.com.
# Leave empty for same-origin only - nginx forwards the original Host header.
ENV_CSRF_TRUSTED_ORIGINS=
ENV_DEFAULT_LANGUAGE=pl
ENV_SHOW_ADMIN_WINDOW=0
ENV_PUBLIC_API_AVAILABLE=1
# Logger profile: dev | demo | prod
ENV_LOGGER=prod

# --- PostgreSQL --------------------------------------------------------------
ENV_DB_ENGINE=django.db.backends.postgresql
ENV_DB_NAME=sse_backend
ENV_DB_USERNAME=admin
ENV_DB_PASSWORD=CHANGE_ME
ENV_DB_HOST=localhost
ENV_DB_PORT=5471

# Used by scripts/admin/postgres.sh and docker-compose.yml
POSTGRES_DB=sse_backend
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5471
# Used by scripts/admin/postgres.sh: keep 127.0.0.1 and firewall/SSH-tunnel
# remote access. Only a containerised stack may need 0.0.0.0.
POSTGRES_BIND_HOST=127.0.0.1
# scripts/admin/postgres.sh: the Docker image (latest = newest major release) and
# the named volume holding the database.  The volume outlives "./run.sh down";
# only "./run.sh clean" (or docker volume rm) deletes it.
POSTGRES_IMAGE=postgres:latest
POSTGRES_DATA_VOLUME=postgres_data

# --- Milvus ------------------------------------------------------------------
# Connection scheme (`uri`: http | https) is read from
# configs/milvus_config.json and is not overridable here.
ENV_MILVUS_HOST=localhost
ENV_MILVUS_PORT=19530
ENV_MILVUS_DBNAME=sse_backend_engine
ENV_MILVUS_USER=sse_user
ENV_MILVUS_PASSWORD=CHANGE_ME

# --- Authentication ----------------------------------------------------------
ENV_USE_KC_AUTH=0
ENV_USE_OAUTH_V1_AUTH=0
ENV_USE_OAUTH_V2_AUTH=0
ENV_USE_INTROSPECT=0
ENV_INTROSPECT_EMAIL_VERIFICATION=0

# --- Optional integrations ---------------------------------------------------
# Indexing in a Celery queue instead of in the request which uploaded the
# files.  With 1 a worker (docker compose service `worker`, or
# `celery -A sse_api.config worker -Q indexing`, or `./run.sh worker`) has to
# run, and RabbitMQ (service `rabbitmq`, or `./run.sh infra`) has to be
# reachable.
ENV_USE_CELERY=1
# Defaults to the localhost broker created by `./run.sh infra` (user `sse`);
# inside `docker compose` the host of the broker is `rabbitmq`.
ENV_CELERY_BROKER_URL=amqp://sse:sse@localhost:5672/
# Results are not needed (the progress is kept in PostgreSQL); set it only
# when something else than the engine reads the results of tasks.
ENV_CELERY_RESULT_BACKEND=
# Hard limit of one task in seconds; documents bigger than this fail.
ENV_CELERY_TASK_TIME_LIMIT=14400
# Credentials of the RabbitMQ container (RABBITMQ_DEFAULT_USER/PASS). The
# defaults work for the loopback broker from `./run.sh infra`; change both
# before publishing the port on another interface.
RABBITMQ_USER=sse
RABBITMQ_PASSWORD=sse
# Address and port the broker is published on; loopback only by default.
RABBITMQ_BIND_HOST=127.0.0.1
RABBITMQ_HOST_PORT=5672
# Management UI of the broker (http://127.0.0.1:15672, queues and their
# messages); published by `./run.sh infra`, loopback only.
RABBITMQ_MGMT_HOST_PORT=15672
# Processes of one worker. The embedder lives in the worker process, so keep
# this at 1 unless there is enough memory (or GPU) for every copy.
CELERY_CONCURRENCY=1
# Pool of the worker. Keep `solo`: reading the uploaded files runs in a
# `multiprocessing.Pool` of its own, and the tasks of the `prefork` pool are
# daemonic children, which Python does not allow to have children of their own
# ("daemonic processes are not allowed to have children"). `solo` runs a task
# in the worker process itself, so the parallel reading keeps working;
# `CELERY_CONCURRENCY` is used by the other pools only.
CELERY_WORKER_POOL=solo
ENV_USE_AWS=0

# --- External model / API keys ----------------------------------------------
LLM_ROUTER_API=
LLM_ROUTER_TOKEN=
OPENAI_API_KEY=
DEEPL_AUTH_KEY=

# --- Uploads -----------------------------------------------------------------
# Must be >= the largest document you accept (bytes). Nginx client_max_body_size
# has to match this value.
DATA_UPLOAD_MAX_MEMORY_SIZE=2684354560
FILE_UPLOAD_MAX_MEMORY_SIZE=2684354560

# --- gunicorn ----------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
# Recycle a worker after roughly this many requests (0 disables it). Guards
# against slow memory growth of the embedding models.
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
# Fork-safety of the CUDA context: leave 0 unless every worker is CPU only.
GUNICORN_PRELOAD=0
GUNICORN_LOGLEVEL=info
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-

# --- Model service (embedding / reranking outside the engine) ----------------
# The engine loads its embedder (and, on the first reranked query, its
# reranker) into its own process by default. Turning this on moves that work to
# a separate service (src/sse_models, `./run.sh models`), so inference can run
# on another — GPU — machine, scale per operation and reload without
# restarting the engine.
#
# Off by default: with SSE_MODEL_SERVICE_ENABLED unset the engine behaves
# exactly as before.
SSE_MODEL_SERVICE_ENABLED=0
# Base url of the service as the ENGINE reaches it.
SSE_MODEL_SERVICE_URL=http://127.0.0.1:8280
# Shared secret; empty means the service is open (fine on an internal network
# only). The service reads the same variable as SSE_MODELS_API_TOKEN.
SSE_MODEL_SERVICE_TOKEN=
# Read timeout of one embed/rerank call. A remote call must not outlive the
# engine's search budget: keep it below the timeout the client allows for a
# search request.
SSE_MODEL_SERVICE_TIMEOUT_SECONDS=30
# A service that is not there at all is recognised in milliseconds, not after
# the full read timeout.
SSE_MODEL_SERVICE_CONNECT_TIMEOUT_SECONDS=3
# When the service fails, fall back to in-process models instead of failing the
# search. Reranking is an enhancement — losing it must not lose the results.
SSE_MODEL_SERVICE_FALLBACK_LOCAL=1
# After this many consecutive failures the engine stops calling the service for
# a while, so a dead service costs one timeout and not one per query.
SSE_MODEL_SERVICE_FAILURE_THRESHOLD=3
SSE_MODEL_SERVICE_COOLDOWN_SECONDS=30
# Per-model placement lives in configs/embedders.json and configs/rerankers.json
# (the "device" key: cpu / cuda / cuda:1 / cuda:2). CUDA_VISIBLE_DEVICES remaps
# the indices, so cuda:1 is the Nth GPU in that list, not GPU number N.
# Which model names to send. Usually unset: the engine resolves the name from
# the model path via configs/embedders.json and configs/rerankers.json. Set
# them only to run a different model remotely than locally.
#SSE_MODEL_SERVICE_EMBED_MODEL=google/embeddinggemma-300m
#SSE_MODEL_SERVICE_RERANK_MODEL=qwen/Qwen3-Reranker-0.6

# --- Model service process (read by `./run.sh models` / `python -m sse_models`)
# All-in-one on one host: leave the role at `all`. To separate the two
# operations, start one instance per host with role=embed and role=rerank —
# the reranker is the one that wants the GPU.
SSE_MODELS_HOST=0.0.0.0
SSE_MODELS_PORT=8280
SSE_MODELS_ROLE=all
SSE_MODELS_API_TOKEN=
# Load every active model at startup instead of on first use. Use it behind a
# load balancer that expects an instant ready signal.
SSE_MODELS_WARM_MODELS=0
# Upper bound of documents one /v1/rerank call may score.
SSE_MODELS_RERANK_MAX_DOCUMENTS=256
# Token window the T5 denoiser (POST /v1/denoise) feeds the model. The engine
# used this same value before cleaning moved to the service.
SSE_MODELS_DENOISE_MAX_MODEL_INPUT=256
SSE_MODELS_LOG_LEVEL=info

# --- Docker Compose stack ----------------------------------------------------
# Image tag built/used by docker-compose.yml (kept in sync with `.version`).
SSE_IMAGE_TAG=0.0.2
# Host port of the API container. It is published on 127.0.0.1 only — nginx is
# the single public entry point.
API_HOST_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Address the Milvus ports are published on (19530 SDK, 19121 metrics). Used by
# docker-compose.yml and run.sh/run-en.sh. Keep the loopback default; 0.0.0.0
# only on a trusted network.
MILVUS_BIND_HOST=127.0.0.1
MILVUS_HOST_PORT=19530
MILVUS_METRICS_HOST_PORT=19121
# Enable Milvus RBAC only after `ENV_MILVUS_USER`/`ENV_MILVUS_PASSWORD` exist
# inside Milvus; the stock image starts with authorization off.
MILVUS_AUTH_ENABLED=false
# Credentials of the MinIO instance backing Milvus (compose network only, no
# published ports). docker-compose.yml refuses to start when these are missing.
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# --- image build args --------------------------------------------------------
# Optional dependencies baked into the image (same installs as
# `./initialize.sh dep`).  radlab-data comes from `requirements.txt` (PyPI);
# llm-router has no release yet, so it is built from the git ref below.
INSTALL_LLM_ROUTER=0
LLM_ROUTER_REF=master
