# Pylint configuration.
#
# This file was a 600+ line dump of every default option (plus a stale
# [MESSAGES CONTROL] block). Only the settings that deviate from the pylint
# 3.x defaults are kept here; everything else is inherited.

[MAIN]
py-version = 3.10
recursive = yes

[MESSAGES CONTROL]
# Django ORM members (objects, DoesNotExist, ...) are not visible to pylint.
disable =
    raw-checker-failed,
    bad-inline-option,
    file-ignored,
    suppressed-message,
    useless-suppression,
    deprecated-pragma

[FORMAT]
max-line-length = 100
